{
  "name": "idol-radar",
  "version": "0.1.0",
  "private": true,
  "description": "使用自建 Spring Boot 后端的追星动态雷达微信小程序",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "scripts": {
    "check": "pnpm run check:syntax && pnpm run typecheck && pnpm test && pnpm run test:admin && pnpm run admin:build && pnpm run validate",
    "check:syntax": "node scripts/check-syntax.js",
    "typecheck": "pnpm --filter @idolradar/admin-web typecheck",
    "test": "node scripts/run-node-tests.mjs",
    "test:admin": "pnpm --filter @idolradar/admin-web test",
    "admin:dev": "pnpm --filter @idolradar/admin-web dev",
    "admin:build": "pnpm --filter @idolradar/admin-web build",
    "test:miniprogram:e2e": "pnpm --filter @idolradar/miniprogram-e2e test",
    "test:miniprogram:e2e:watch": "pnpm --filter @idolradar/miniprogram-e2e test:watch",
    "rsshub:install": "pnpm --dir rsshub install --frozen-lockfile",
    "rsshub:dev": "pnpm --dir rsshub dev",
    "rsshub:test": "pnpm --dir rsshub vitest",
    "validate": "node scripts/validate-project.js --allow-placeholders",
    "validate:release": "node scripts/validate-project.js"
  }
}
