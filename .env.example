# 根目录 compose.yaml 的 RSSHub 配置。
RSSHUB_IMAGE=idolradar-rsshub:local
RSSHUB_PORT=1200

# 完整部署接入 redis 服务后，如启用密码，请填写 URL 编码后的完整连接串。
RSSHUB_REDIS_URL=redis://redis:6379/
RSSHUB_CACHE_EXPIRE=300
RSSHUB_REQUEST_RETRY=2
RSSHUB_REQUEST_TIMEOUT=30000

# 0：构建时内置 Chromium，route 覆盖最完整；1：跳过浏览器下载以减小镜像。
RSSHUB_PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0

# TODO(backend/database/redis): 由对应维护者在根 Compose 接入服务时追加变量，
# 敏感值只写入被 Git 忽略的 .env，不得提交到本示例文件。
