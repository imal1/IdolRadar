COMPOSE_PROJECT_NAME=idolradar
MAVEN_MIRROR_URL=https://mirrors.cloud.tencent.com/nexus/repository/maven-public/

# PostgreSQL/Redis 密码只放服务器 .env，不提交 Git。
POSTGRES_DB=idolradar
POSTGRES_USER=idolradar
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=10
REDIS_PASSWORD=replace-with-a-different-strong-redis-password
REDIS_PORT=6379
APP_PORT=8080

# Nginx 域名与证书路径。证书文件本身禁止放入 Git。
SERVER_NAME=replace-with-your-domain
TLS_CERT_FILE=/opt/idolradar/certs/fullchain.crt
TLS_KEY_FILE=/opt/idolradar/certs/private.key
HTTP_PORT=80
HTTPS_PORT=443

# Java API 与 Worker 共用同一套微信小程序身份。
WECHAT_APP_ID=replace-with-your-miniprogram-appid
WECHAT_APP_SECRET=replace-with-your-server-side-appsecret
SUBSCRIBE_TEMPLATE_ID=replace-with-your-subscribe-message-template-id
# 首次只验收 RSS 入库时保持 false；模板与真机授权验证完成后改为 true。
NOTIFICATIONS_ENABLED=false
MINIPROGRAM_STATE=formal

# RSSHub 仅暴露在 Docker 私有网络。微博 Cookie 只注入 RSSHub。
RSSHUB_IMAGE=idolradar-rsshub:local
RSSHUB_BASE_URL=http://rsshub:1200
RSS_TRUSTED_ORIGINS=http://rsshub:1200
RSSHUB_REDIS_URL=redis://rsshub-cache:6379/
RSSHUB_CACHE_EXPIRE=300
RSSHUB_REQUEST_RETRY=2
RSSHUB_REQUEST_TIMEOUT=30000
# 0：构建时内置 Chromium；1：跳过浏览器下载以减小镜像。
RSSHUB_PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=0
WEIBO_COOKIES=

WORKER_INTERVAL=PT30M
WORKER_INITIAL_DELAY=PT5S
SESSION_TTL=30d
RATE_LIMIT_IP=1200
RATE_LIMIT_USER=120
RATE_LIMIT_LOGIN=20
RATE_LIMIT_SUBSCRIPTION=12
RSS_TIMEOUT=10s
RSS_MAX_RESPONSE_BYTES=2097152
RSS_MAX_REDIRECTS=3
RSS_MAX_ENTRIES_PER_SOURCE=100
RSS_SOURCE_CONCURRENCY=4
NOTIFY_CONCURRENCY=8
NOTIFICATION_LEASE=15m
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE=1m
LOG_LEVEL=INFO
